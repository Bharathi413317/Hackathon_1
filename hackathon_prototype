<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChainTrace - Blockchain Transaction Analyzer</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-primary: #0a0e17;
            --bg-secondary: #111827;
            --bg-tertiary: #1a2332;
            --bg-card: #151d2e;
            --accent-primary: #00d4aa;
            --accent-secondary: #6366f1;
            --accent-tertiary: #f59e0b;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --border-color: #2d3748;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --gradient-primary: linear-gradient(135deg, #00d4aa 0%, #6366f1 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Animated Background */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .bg-animation::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: 
                radial-gradient(ellipse at 20% 20%, rgba(99, 102, 241, 0.1) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 80%, rgba(0, 212, 170, 0.08) 0%, transparent 50%);
            animation: bgPulse 15s ease-in-out infinite;
        }

        @keyframes bgPulse {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            33% { transform: translate(2%, 2%) rotate(1deg); }
            66% { transform: translate(-1%, 1%) rotate(-1deg); }
        }

        /* Header */
        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(10, 14, 23, 0.9);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 2rem;
        }

        .header-content {
            max-width: 1600px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: var(--gradient-primary);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .logo span {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
            position: relative;
        }

        .nav-links a:hover {
            color: var(--accent-primary);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--accent-primary);
            transition: width 0.3s;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* Main Content */
        main {
            position: relative;
            z-index: 1;
            padding: 8rem 2rem 4rem;
            max-width: 1600px;
            margin: 0 auto;
        }

        /* Hero Section */
        .hero {
            text-align: center;
            margin-bottom: 4rem;
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .hero h1 .highlight {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 1.25rem;
            color: var(--text-secondary);
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.7;
        }

        /* Search Container */
        .search-container {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 3rem;
            position: relative;
            overflow: hidden;
        }

        .search-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--gradient-primary);
        }

        .search-box {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .search-input-wrapper {
            flex: 1;
            position: relative;
        }

        .search-input-wrapper i {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1.25rem;
        }

        .search-input {
            width: 100%;
            padding: 1.25rem 1.25rem 1.25rem 3.5rem;
            background: var(--bg-tertiary);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            color: var(--text-primary);
            font-size: 1rem;
            font-family: 'JetBrains Mono', monospace;
            transition: all 0.3s;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 4px rgba(0, 212, 170, 0.1);
        }

        .search-input::placeholder {
            color: var(--text-muted);
        }

        .analyze-btn {
            padding: 1.25rem 2.5rem;
            background: var(--gradient-primary);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .analyze-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 212, 170, 0.3);
        }

        .analyze-btn.loading {
            pointer-events: none;
            opacity: 0.8;
        }

        .analyze-btn .spinner {
            display: none;
            animation: spin 1s linear infinite;
        }

        .analyze-btn.loading .spinner {
            display: inline-block;
        }

        .analyze-btn.loading .btn-text {
            display: none;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Chain Selector */
        .chain-selector {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .chain-option {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.25rem;
            background: var(--bg-tertiary);
            border: 2px solid var(--border-color);
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .chain-option:hover {
            border-color: var(--text-muted);
        }

        .chain-option.active {
            border-color: var(--accent-primary);
            background: rgba(0, 212, 170, 0.1);
        }

        .chain-option input {
            display: none;
        }

        .chain-option .check {
            width: 18px;
            height: 18px;
            border: 2px solid var(--border-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .chain-option.active .check {
            border-color: var(--accent-primary);
            background: var(--accent-primary);
        }

        .chain-option.active .check::after {
            content: '✓';
            color: var(--bg-primary);
            font-size: 0.7rem;
            font-weight: bold;
        }

        .chain-icon {
            width: 24px;
            height: 24px;
            border-radius: 50%;
        }

        /* Dashboard Grid */
        .dashboard {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.5rem;
            transition: all 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            border-color: var(--accent-primary);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .stat-icon.primary {
            background: rgba(0, 212, 170, 0.15);
            color: var(--accent-primary);
        }

        .stat-icon.secondary {
            background: rgba(99, 102, 241, 0.15);
            color: var(--accent-secondary);
        }

        .stat-icon.tertiary {
            background: rgba(245, 158, 11, 0.15);
            color: var(--accent-tertiary);
        }

        .stat-trend {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            font-size: 0.875rem;
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
        }

        .stat-trend.up {
            background: rgba(16, 185, 129, 0.15);
            color: var(--success);
        }

        .stat-trend.down {
            background: rgba(239, 68, 68, 0.15);
            color: var(--danger);
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            color: var(--text-secondary);
            font-size: 0.875rem;
        }

        /* Results Section */
        .results-section {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 1.5rem;
        }

        .results-main {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2rem;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .section-title i {
            color: var(--accent-primary);
        }

        /* Transaction Flow */
        .transaction-flow {
            position: relative;
            min-height: 400px;
        }

        .flow-node {
            position: absolute;
            background: var(--bg-tertiary);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            min-width: 200px;
            transition: all 0.3s;
        }

        .flow-node:hover {
            border-color: var(--accent-primary);
            transform: scale(1.02);
        }

        .flow-node.origin {
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            border-color: var(--accent-secondary);
        }

        .flow-node.intermediate {
            top: 150px;
            left: 50%;
            transform: translateX(-50%);
            border-color: var(--accent-tertiary);
        }

        .flow-node.end-receiver {
            top: 300px;
            left: 50%;
            transform: translateX(-50%);
            border-color: var(--accent-primary);
            background: rgba(0, 212, 170, 0.1);
        }

        .node-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .node-address {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            color: var(--text-primary);
            word-break: break-all;
        }

        .node-amount {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--accent-primary);
            margin-top: 0.5rem;
        }

        .flow-arrow {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            color: var(--text-muted);
            font-size: 1.5rem;
        }

        .flow-arrow.first {
            top: 80px;
        }

        .flow-arrow.second {
            top: 230px;
        }

        /* Analysis Panel */
        .analysis-panel {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .analysis-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.5rem;
        }

        .analysis-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--border-color);
        }

        .analysis-item:last-child {
            border-bottom: none;
        }

        .analysis-label {
            color: var(--text-secondary);
            font-size: 0.875rem;
        }

        .analysis-value {
            font-weight: 600;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
        }

        .confidence-bar {
            height: 8px;
            background: var(--bg-tertiary);
            border-radius: 4px;
            margin-top: 0.5rem;
            overflow: hidden;
        }

        .confidence-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 1s ease;
        }

        /* Pattern Visualization */
        .pattern-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-top: 1rem;
        }

        .pattern-item {
            background: var(--bg-tertiary);
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
            transition: all 0.3s;
        }

        .pattern-item:hover {
            background: rgba(0, 212, 170, 0.1);
        }

        .pattern-item.active {
            border: 1px solid var(--accent-primary);
            background: rgba(0, 212, 170, 0.1);
        }

        .pattern-icon {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .pattern-name {
            font-size: 0.875rem;
            color: var(--text-secondary);
        }

        /* Wallet Info Card */
        .wallet-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.5rem;
        }

        .wallet-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .wallet-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 700;
        }

        .wallet-info h3 {
            font-size: 1rem;
            margin-bottom: 0.25rem;
        }

        .wallet-info span {
            font-size: 0.875rem;
            color: var(--text-secondary);
        }

        .wallet-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .wallet-stat {
            background: var(--bg-tertiary);
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
        }

        .wallet-stat-value {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--accent-primary);
        }

        .wallet-stat-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        /* Risk Badge */
        .risk-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 600;
        }

        .risk-badge.low {
            background: rgba(16, 185, 129, 0.15);
            color: var(--success);
        }

        .risk-badge.medium {
            background: rgba(245, 158, 11, 0.15);
            color: var(--warning);
        }

        .risk-badge.high {
            background: rgba(239, 68, 68, 0.15);
            color: var(--danger);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--text-muted);
        }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 1.5rem;
            opacity: 0.5;
        }

        .empty-state h3 {
            font-size: 1.25rem;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-in {
            animation: fadeInUp 0.5s ease forwards;
        }

        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        /* Loading Skeleton */
        .skeleton {
            background: linear-gradient(90deg, var(--bg-tertiary) 25%, var(--bg-secondary) 50%, var(--bg-tertiary) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: 8px;
        }

        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .dashboard {
                grid-template-columns: repeat(2, 1fr);
            }
            .results-section {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2.5rem;
            }
            .dashboard {
                grid-template-columns: 1fr;
            }
            .search-box {
                flex-direction: column;
            }
            .analyze-btn {
                width: 100%;
                justify-content: center;
            }
            .nav-links {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="bg-animation"></div>

    <header>
        <div class="header-content">
            <div class="logo">
                <div class="logo-icon">
                    <i class="fas fa-link"></i>
                </div>
                <span>ChainTrace</span>
            </div>
            <nav>
                <ul class="nav-links">
                    <li><a href="#">Dashboard</a></li>
                    <li><a href="#">Transactions</a></li>
                    <li><a href="#">Wallets</a></li>
                    <li><a href="#">Analytics</a></li>
                    <li><a href="#">Reports</a></li>
                </ul>
            </nav>
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--bg-tertiary); display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-bell" style="color: var(--text-secondary);"></i>
                </div>
                <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--gradient-primary); display: flex; align-items: center; justify-content: center; font-weight: 600;">
                    A
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="hero animate-in">
            <h1>Identify End Receivers with<br><span class="highlight">Behavioral Pattern Analysis</span></h1>
            <p>Advanced blockchain forensics tool that traces transactions across multiple wallets and chains using sophisticated behavioral pattern recognition to identify the true end receiver.</p>
        </section>

        <section class="search-container animate-in delay-1">
            <div class="search-box">
                <div class="search-input-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" class="search-input" id="transactionInput" placeholder="Enter transaction hash or wallet address (e.g., 0x742d35Cc6634C0532925a3b844Bc9e7595f...)">
                </div>
                <button class="analyze-btn" id="analyzeBtn" onclick="analyzeTransaction()">
                    <span class="btn-text"><i class="fas fa-radar"></i> Analyze</span>
                    <i class="fas fa-spinner spinner"></i>
                </button>
            </div>
            <div class="chain-selector">
                <label class="chain-option active" data-chain="ethereum">
                    <input type="checkbox" checked>
                    <span class="check"></span>
                    <img src="https://cryptologos.cc/logos/ethereum-eth-logo.svg" class="chain-icon" alt="ETH">
                    <span>Ethereum</span>
                </label>
                <label class="chain-option" data-chain="bitcoin">
                    <input type="checkbox">
                    <span class="check"></span>
                    <img src="https://cryptologos.cc/logos/bitcoin-btc-logo.svg" class="chain-icon" alt="BTC">
                    <span>Bitcoin</span>
                </label>
                <label class="chain-option" data-chain="binance">
                    <input type="checkbox">
                    <span class="check"></span>
                    <img src="https://cryptologos.cc/logos/bnb-bnb-logo.svg" class="chain-icon" alt="BNB">
                    <span>BNB Chain</span>
                </label>
                <label class="chain-option" data-chain="polygon">
                    <input type="checkbox">
                    <span class="check"></span>
                    <img src="https://cryptologos.cc/logos/polygon-matic-logo.svg" class="chain-icon" alt="MATIC">
                    <span>Polygon</span>
                </label>
                <label class="chain-option" data-chain="solana">
                    <input type="checkbox">
                    <span class="check"></span>
                    <img src="https://cryptologos.cc/logos/solana-sol-logo.svg" class="chain-icon" alt="SOL">
                    <span>Solana</span>
                </label>
            </div>
        </section>

        <section class="dashboard animate-in delay-2" id="dashboard" style="display: none;">
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon primary">
                        <i class="fas fa-route"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-arrow-up"></i>
                        <span>Hops</span>
                    </div>
                </div>
                <div class="stat-value" id="hopCount">0</div>
                <div class="stat-label">Transaction Hops</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon secondary">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-arrow-up"></i>
                        <span>Chains</span>
                    </div>
                </div>
                <div class="stat-value" id="chainCount">0</div>
                <div class="stat-label">Cross-Chain Bridges</div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon tertiary">
                        <i class="fas fa-percentage"></i>
                    </div>
                    <div class="stat-trend up">
                        <i class="fas fa-arrow-up"></i>
                        <span>Confidence</span>
                    </div>
                </div>
                <div class="stat-value" id="confidenceScore">0%</div>
                <div class="stat-label">Analysis Confidence</div>
            </div>
        </section>

        <section class="results-section animate-in delay-3" id="resultsSection" style="display: none;">
            <div class="results-main">
                <div class="section-header">
                    <h2 class="section-title"><i class="fas fa-project-diagram"></i> Transaction Flow Analysis</h2>
                    <button style="background: var(--bg-tertiary); border: 1px solid var(--border-color); padding: 0.5rem 1rem; border-radius: 8px; color: var(--text-secondary); cursor: pointer;">
                        <i class="fas fa-download"></i> Export
                    </button>
                </div>
                <div class="transaction-flow" id="transactionFlow">
                    <div class="flow-node origin">
                        <div class="node-label">Origin Wallet</div>
                        <div class="node-address" id="originAddress">0x742d...8f21</div>
                        <div class="node-amount" id="originAmount">5.42 ETH</div>
                    </div>
                    <i class="fas fa-arrow-down flow-arrow first"></i>
                    
                    <div class="flow-node intermediate">
                        <div class="node-label">Intermediate Wallet 1</div>
                        <div class="node-address" id="intermediate1">0x8a2d...3c12</div>
                        <div class="node-amount" id="intermediate1Amount">4.85 ETH</div>
                    </div>
                    <i class="fas fa-arrow-down flow-arrow second"></i>
                    
                    <div class="flow-node end-receiver">
                        <div class="node-label">End Receiver Identified</div>
                        <div class="node-address" id="endReceiver">0x1a2b...9d45</div>
                        <div class="node-amount" id="endAmount">4.12 ETH</div>
                    </div>
                </div>
            </div>
            
            <div class="analysis-panel">
                <div class="analysis-card">
                    <h3 class="section-title" style="margin-bottom: 1rem;"><i class="fas fa-shield-alt"></i> Risk Assessment</h3>
                    <div class="risk-badge medium" id="riskBadge" style="margin-bottom: 1.5rem;">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Medium Risk</span>
                    </div>
                    
                    <div class="analysis-item">
                        <span class="analysis-label">Wallet Age</span>
                        <span class="analysis-value" id="walletAge">247 days</span>
                    </div>
                    <div class="analysis-item">
                        <span class="analysis-label">Transaction Count</span>
                        <span class="analysis-value" id="txCount">1,247</span>
                    </div>
                    <div class="analysis-item">
                        <span class="analysis-label">Total Volume</span>
                        <span class="analysis-value" id="totalVolume">$2.4M</span>
                    </div>
                    <div class="analysis-item">
                        <span class="analysis-label">Interaction Pattern</span>
                        <span class="analysis-value" id="pattern">Mixer-like</span>
                    </div>
                </div>

                <div class="analysis-card">
                    <h3 class="section-title" style="margin-bottom: 1rem;"><i class="fas fa-fingerprint"></i> Behavioral Patterns</h3>
                    <div class="pattern-grid">
                        <div class="pattern-item">
                            <div class="pattern-icon" style="color: var(--accent-primary);"><i class="fas fa-random"></i></div>
                            <div class="pattern-name">Time Delay</div>
                        </div>
                        <div class="pattern-item active">
                            <div class="pattern-icon" style="color: var(--accent-secondary);"><i class="fas fa-cut"></i></div>
                            <div class="pattern-name">Amount Splitting</div>
                        </div>
                        <div class="pattern-item">
                            <div class="pattern-icon" style="color: var(--accent-tertiary);"><i class="fas fa-exchange-alt"></i></div>
                            <div class="pattern-name">Cross-Chain</div>
                        </div>
                        <div class="pattern-item active">
                            <div class="pattern-icon" style="color: var(--danger);"><i class="fas fa-user-secret"></i></div>
                            <div class="pattern-name">Mixer Usage</div>
                        </div>
                    </div>
                </div>

                <div class="wallet-card">
                    <div class="wallet-header">
                        <div class="wallet-avatar" id="walletAvatar">ER</div>
                        <div class="wallet-info">
                            <h3>End Receiver</h3>
                            <span id="walletType">Primary Identity</span>
                        </div>
                    </div>
                    <div class="wallet-stats">
                        <div class="wallet-stat">
                            <div class="wallet-stat-value" id="associatedWallets">12</div>
                            <div class="wallet-stat-label">Associated Wallets</div>
                        </div>
                        <div class="wallet-stat">
                            <div class="wallet-stat-value" id="correlationScore">87%</div>
                            <div class="wallet-stat-label">Correlation Score</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="empty-state animate-in delay-1" id="emptyState">
            <i class="fas fa-search-dollar"></i>
            <h3>Start Transaction Analysis</h3>
            <p>Enter a transaction hash or wallet address above to trace the end receiver using behavioral pattern analysis.</p>
        </section>
    </main>

    <script>
        // Chain selector functionality
        document.querySelectorAll('.chain-option').forEach(option => {
            option.addEventListener('click', () => {
                option.classList.toggle('active');
                const checkbox = option.querySelector('input[type="checkbox"]');
                checkbox.checked = !checkbox.checked;
            });
        });

        // Demo data for simulation
        const demoData = {
            '0x742d35Cc6634C0532925a3b844Bc9e7595f1234567890abcdef1234567890abcdef': {
                origin: '0x742d35Cc6634C0532925a3b844Bc9e7595f1234',
                intermediate1: '0x8a2d35Cc6634C0532925a3b844Bc9e7595f3c12',
                endReceiver: '0x1a2b35Cc6634C0532925a3b844Bc9e7595f9d45',
                amount: '5.42',
                currency: 'ETH',
                hops: 3,
                chains: 1,
                confidence: 94,
                risk: 'medium',
                walletAge: '247 days',
                txCount: '1,247',
                totalVolume: '$2.4M',
                pattern: 'Mixer-like',
                associatedWallets: 12,
                correlationScore: 87
            },
            'default': {
                origin: '0x742d35Cc6634C0532925a3b844Bc9e7595f1234',
                intermediate1: '0x8a2d35Cc6634C0532925a3b844Bc9e7595f3c12',
                endReceiver: '0x1a2b35Cc6634C0532925a3b844Bc9e7595f9d45',
                amount: (Math.random() * 10).toFixed(2),
                currency: 'ETH',
                hops: Math.floor(Math.random() * 5) + 2,
                chains: Math.floor(Math.random() * 3) + 1,
                confidence: Math.floor(Math.random() * 20) + 80,
                risk: ['low', 'medium', 'high'][Math.floor(Math.random() * 3)],
                walletAge: Math.floor(Math.random() * 500) + 30 + ' days',
                txCount: Math.floor(Math.random() * 5000) + 100,
                totalVolume: '$' + (Math.random() * 10).toFixed(1) + 'M',
                pattern: ['Mixer-like', 'Coin Join', 'Flash Loan', 'Bridge Transfer'][Math.floor(Math.random() * 4)],
                associatedWallets: Math.floor(Math.random() * 20) + 5,
                correlationScore: Math.floor(Math.random() * 15) + 80
            }
        };

        function shortenAddress(address) {
            if (!address) return '';
            return address.substring(0, 6) + '...' + address.substring(address.length - 4);
        }

        function analyzeTransaction() {
            const input = document.getElementById('transactionInput').value.trim();
            const btn = document.getElementById('analyzeBtn');
            const emptyState = document.getElementById('emptyState');
            const dashboard = document.getElementById('dashboard');
            const resultsSection = document.getElementById('resultsSection');

            if (!input) {
                alert('Please enter a transaction hash or wallet address');
                return;
            }

            // Show loading state
            btn.classList.add('loading');
            
            // Simulate analysis delay
            setTimeout(() => {
                // Get demo data based on input
                let data = demoData[input] || demoData['default'];
                data = { ...data }; // Clone to avoid mutation
                
                // If using default, randomize the amount
                if (!demoData[input]) {
                    data.amount = (Math.random() * 10).toFixed(2);
                }

                // Hide empty state, show dashboard and results
                emptyState.style.display = 'none';
                dashboard.style.display = 'grid';
                resultsSection.style.display = 'grid';

                // Update stats
                document.getElementById('hopCount').textContent = data.hops;
                document.getElementById('chainCount').textContent = data.chains;
                document.getElementById('confidenceScore').textContent = data.confidence + '%';

                // Update transaction flow
                document.getElementById('originAddress').textContent = shortenAddress(data.origin);
                document.getElementById('originAmount').textContent = data.amount + ' ' + data.currency;
                document.getElementById('intermediate1').textContent = shortenAddress(data.intermediate1);
                document.getElementById('intermediate1Amount').textContent = (parseFloat(data.amount) * 0.9).toFixed(2) + ' ' + data.currency;
                document.getElementById('endReceiver').textContent = shortenAddress(data.endReceiver);
                document.getElementById('endAmount').textContent = (parseFloat(data.amount) * 0.76).toFixed(2) + ' ' + data.currency;

                // Update risk assessment
                const riskBadge = document.getElementById('riskBadge');
                riskBadge.className = 'risk-badge ' + data.risk;
                riskBadge.innerHTML = `<i class="fas fa-${data.risk === 'high' ? 'exclamation-triangle' : data.risk === 'medium' ? 'exclamation-circle' : 'check-circle'}"></i><span>${data.risk.charAt(0).toUpperCase() + data.risk.slice(1)} Risk</span>`;

                document.getElementById('walletAge').textContent = data.walletAge;
                document.getElementById('txCount').textContent = data.txCount.toLocaleString();
                document.getElementById('totalVolume').textContent = data.totalVolume;
                document.getElementById('pattern').textContent = data.pattern;
                document.getElementById('associatedWallets').textContent = data.associatedWallets;
                document.getElementById('correlationScore').textContent = data.correlationScore + '%';

                // Update wallet avatar
                document.getElementById('walletAvatar').textContent = data.endReceiver.substring(2, 4).toUpperCase();

                // Update confidence bar animation
                const confidenceFill = document.querySelector('.confidence-fill');
                if (confidenceFill) {
                    confidenceFill.style.width = data.confidence + '%';
                }

                // Remove loading state
                btn.classList.remove('loading');

                // Animate stats counting
                animateValue('hopCount', 0, data.hops, 1000);
                animateValue('chainCount', 0, data.chains, 1000);
                animateValue('confidenceScore', 0, data.confidence, 1000, '%');

            }, 2000);
        }

        function animateValue(id, start, end, duration, suffix = '') {
            const obj = document.getElementById(id);
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                obj.innerHTML = Math.floor(progress * (end - start) + start) + suffix;
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        }

        // Enter key handler
        document.getElementById('transactionInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                analyzeTransaction();
            }
        });

        // Initialize with sample data for demo
        window.addEventListener('load', () => {
            document.getElementById('transactionInput').value = '0x742d35Cc6634C0532925a3b844Bc9e7595f1234567890abcdef1234567890abcdef';
        });
    </script>
</body>
</html>

